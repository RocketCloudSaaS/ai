<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="ai_api_connection_form_view">
        <field name="model">ai.api.connection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="base_url" />
                            <field name="description" />
                            <field name="default_endpoint" />
                            <field name="default_method" />
                        </group>
                        <group>
                            <field name="auth_type" />
                            <field
                                name="auth_value"
                                password="True"
                                invisible="auth_type == 'none'"
                                required="auth_type not in ('none',)"
                            />
                            <field
                                name="auth_header_name"
                                invisible="auth_type != 'api_key'"
                                required="auth_type == 'api_key'"
                            />
                            <field name="default_headers" />
                            <field name="default_body" />
                            <field name="default_timeout" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_api_connection_list_view">
        <field name="model">ai.api.connection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="base_url" />
                <field name="default_method" />
                <field name="default_endpoint" />
                <field name="auth_type" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="ai_api_connection_search_view">
        <field name="model">ai.api.connection</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="ai_api_connection_act_window">
        <field name="name">API Connections</field>
        <field name="res_model">ai.api.connection</field>
        <field name="view_mode">list,form</field>
    </record>

    <record model="ir.ui.menu" id="ai_api_connection_menu">
        <field name="name">API Connections</field>
        <field name="parent_id" ref="ai_tool.ai_menu_root" />
        <field name="action" ref="ai_api_connection_act_window" />
        <field name="sequence" eval="17" />
    </record>
</odoo>
