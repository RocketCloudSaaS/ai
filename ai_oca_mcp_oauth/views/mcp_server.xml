<odoo>
    <record model="ir.ui.view" id="mcp_server_form_view">
        <field name="model">mcp.server</field>
        <field name="inherit_id" ref="ai_oca_mcp.mcp_server_form_view" />
        <field name="arch" type="xml">
            <button
                name="%(ai_oca_mcp.mcp_server_key_add_act_window)d"
                position="attributes"
            >
                <attribute name="invisible">auth_type == 'oauth'</attribute>
            </button>
            <field name="description" position="before">
                <field name="auth_type" />
            </field>
            <field name="url" position="after">
                <field
                    name="oauth_resource_metadata_url"
                    widget="CopyClipboardChar"
                    groups="base.group_no_one"
                    invisible="auth_type == 'bearer'"
                />
                <field
                    name="oauth_authorization_server_url"
                    widget="CopyClipboardChar"
                    groups="base.group_no_one"
                    invisible="auth_type == 'bearer'"
                />
            </field>
        </field>
    </record>
</odoo>
